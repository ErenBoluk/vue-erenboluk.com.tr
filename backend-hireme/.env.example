# Resend API Key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# İsteğe bağlı: Maillerin gideceği adres (Boş bırakırsan onboarding@resend.dev kullanır)
RECEIVER_EMAIL=senin-mailin@gmail.com

# Backend'in çalışacağı port (Railway bunu otomatik atar)
PORT=3000

# Spam Koruması (Rate Limiting)
# Aynı IP'den aralıksız kaç mesaj atılabileceği
RATE_LIMIT_MAX=2
# Mesaj sınırına ulaşılınca ne kadar bekleneceği (milisaniye cinsinden, 300000 = 5 dakika)
RATE_LIMIT_WINDOW_MS=300000
