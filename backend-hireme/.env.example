# Backend-only credentials. Never use VITE_ for these values.
RESEND_API_KEY=re_your_placeholder
RECEIVER_EMAIL=erenboluk.dev@gmail.com
PORT=3000
NODE_ENV=development

# Exact origins; production does not allow loopback origins.
ALLOWED_ORIGINS=https://erenboluk.com.tr,https://www.erenboluk.com.tr

# Optional: auto-detected as railway only when Railway environment+service IDs exist.
# Set TRUST_PROXY=none for direct/local connections; railway only behind its trusted edge.
# TRUST_PROXY=railway

# Single-instance limits. No active-key eviction; expired entries are pruned.
RATE_LIMIT_MAX=2
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_ENTRIES=10000
GLOBAL_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_WINDOW_MS=3600000
MAX_IN_FLIGHT=2

BODY_LIMIT_BYTES=16384
BODY_TIMEOUT_MS=5000
RESEND_TIMEOUT_MS=10000
